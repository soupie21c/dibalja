# Supabase 대시보드 > Connect 버튼 > .env.local 탭에서 복사
# .env.local 로 복사해서 값을 채우세요 (cp .env.example .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# 이메일 인증 링크가 돌아올 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [과제 5] Figma 개인 액세스 토큰 — 서버 전용(NEXT_PUBLIC_ 을 붙이지 않음). 없으면 Figma 썸네일 기능만 꺼집니다.
# Figma > Settings > Security > Personal access tokens 에서 "File content: Read-only" 로 발급
FIGMA_TOKEN=
